# infra/.env.example – als infra/.env kopieren und anpassen (die .env wird nicht committet)

# Datenbank (Benutzer und Name frei wählbar, das Passwort unbedingt ändern)
POSTGRES_USER=fuelstat
POSTGRES_PASSWORD=ein-starkes-passwort
POSTGRES_DB=fuelstat

# Signatur der Login-Tokens: mindestens 32 zufällige Zeichen, z. B. openssl rand -base64 48
JWT_SECRET=

# Kommagetrennte User-IDs mit Admin-Rechten (Benutzerverwaltung, Feedback, Beta-Kennzeichen).
# Nach der ersten Registrierung die eigene ID eintragen (Tabelle users, z. B. in Adminer) und die API neu starten:
#   docker compose exec db sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "select id, email from users"'
ADMIN_USER_IDS=

# Version des API-Images (#134). Setzt infra/ausrollen.sh beim Ausrollen einer veröffentlichten Version selbst,
# z. B. FUELSTAT_VERSION=0.11.0; beim Zwischenstand (sudo infra/ausrollen.sh main) FUELSTAT_VERSION=main, das Image
# wird dann aus dem Code gebaut. Leer: Die API wird wie früher aus dem Code gebaut (docker compose up -d --build).
# FUELSTAT_VERSION=
# Zuletzt mit infra/ausrollen.sh ausgerollter Commit; setzt das Skript selbst, nicht von Hand ändern.
# FUELSTAT_COMMIT=
# Optional: anderes Image (Standard ghcr.io/fuelstat/fuelstat-api), z. B. für einen eigenen Fork
# FUELSTAT_API_IMAGE=ghcr.io/fuelstat/fuelstat-api

# Optional: Ports auf 127.0.0.1 (Standard 3000 für die API, 8080 für Adminer)
# API_PORT=3000
# ADMINER_PORT=8080

# Hochgeladene Bilder liegen im Ordner uploads/ neben infra/ (im Container /usr/src/app/uploads, siehe docker-compose.yml).
# Ausgeliefert werden sie nur über signierte, ablaufende Adressen (/api/v1/files/…), nie direkt.
# Optional: eigener Schlüssel für die Signatur (Standard: aus JWT_SECRET abgeleitet), z. B. openssl rand -base64 48.
# Ändert er sich, gelten bis dahin ausgegebene Bildadressen nicht mehr (Seiten laden sie beim nächsten Aufruf neu).
# MEDIA_SIGNING_KEY=

# Optional: Browser-Zugriff auf die API von anderen Seiten (CORS), kommagetrennt. Standard: keiner,
# das PHP-Frontend ruft die API nur serverseitig auf.
# CORS_ORIGINS=https://app.example.com

# E-Mail-Adresse bestätigen (#135): Neue Konten bestätigen ihre Adresse per Link (Standard: an, sobald ein
# Standard-Mailserver eingerichtet ist). Bis dahin: ein Fahrzeug und ein Eintrag. "false" schaltet es ab.
# EMAIL_VERIFICATION=true
# Nutzungsbedingungen (#135): Version der gültigen Fassung (Text: includes/nutzungsbedingungen_text.php), z. B. das Datum.
# Gesetzt: Registrierung nur mit Zustimmung, bestehende Konten stimmen beim nächsten Aufruf zu. Bei inhaltlichen
# Änderungen am Text eine neue Version setzen. Leer: keine Zustimmung (z. B. private Installation).
# TERMS_VERSION=2026-11-09

# Optional: öffentliche Adresse der Seite für Links in E-Mails (z. B. "Kilometerstand nachtragen")
# Auch Grundlage für Passkeys (#2): Domain und Herkunft kommen aus APP_URL (nur https).
# APP_URL=https://fuelstat.example.de

# Optional: Passkeys (#2) abweichend von APP_URL. WEBAUTHN_RP_ID: Domain, an die Passkeys gebunden sind (Standard:
# Host von APP_URL); WEBAUTHN_ORIGINS: erlaubte Adressen, kommagetrennt (Standard: APP_URL). Eine geänderte Domain
# macht vorhandene Passkeys unbrauchbar. Ohne gültige https-Adresse sind Passkeys aus.
# WEBAUTHN_RP_ID=fuelstat.example.de
# WEBAUTHN_ORIGINS=https://fuelstat.example.de

# Optional: Push-Benachrichtigungen (#136) für die installierte Web-App (Android, iPhone ab iOS 16.4, Desktop).
# Schlüssel einmal erzeugen: docker compose exec api node scripts/vapid-schluessel.js – die Ausgabe hier eintragen.
# Ohne Schlüssel ist Push aus (Benachrichtigungen nur per E-Mail). Den privaten Schlüssel nie weitergeben; ein neuer
# Schlüssel macht alle bestehenden Push-Abos ungültig. VAPID_SUBJECT: Kontakt für die Push-Dienste (mailto: oder
# https-Adresse), Standard: APP_URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:betreiber@example.de

# Optional: Tankstellensuche (GET /api/v1/stations) für Web-App und Apps, kostenloser Key von creativecommons.tankerkoenig.de.
# Ohne Key antwortet der Endpunkt mit 503 und die Suche im Erfassungsformular meldet „nicht eingerichtet“.
# TANKERKOENIG_API_KEY=

# Optional: Ladestationssuche (GET /api/v1/charging-stations) für Web-App und Apps, kostenloser Key von
# openchargemap.org (Mein Profil → API-Schlüssel). Ohne Key antwortet der Endpunkt mit 503.
# Beide Keys liegen nur hier; das Frontend fragt die Dienste nie direkt (#123).
# OCM_API_KEY=

# Optional: Tarifgrenzen (Free/Plus/Flotte, siehe backend/src/services/plans.js) durchsetzen.
# Standard: aus – alle Konten haben den vollen Umfang. Tarife je Konto setzt ein Admin in der Benutzerverwaltung.
# PLAN_LIMITS_ENABLED=true

# Optional: öffentliche Registrierung abschalten
# REGISTRATION_ENABLED=false

# Beta-Phase (Standard: an): Hinweis auf der Startseite, neue Konten werden Beta-Tester
# BETA_PHASE=false

# E-Mail-Benachrichtigungen
# MAIL_ENCRYPTION_KEY=           Schlüssel für gespeicherte SMTP-Passwörter und 2FA-Secrets (Standard: aus JWT_SECRET
#                                abgeleitet). Empfohlen: fest setzen, z. B. openssl rand -base64 48 – sonst sind nach
#                                einer Änderung von JWT_SECRET SMTP-Passwörter und 2FA nicht mehr entschlüsselbar.
# ALLOW_PRIVATE_SMTP=true        Mailserver mit interner Adresse erlauben (z. B. im selben Netz)
# NOTIFICATIONS_ENABLED=false    automatischen Versand von Erinnerungen und Monatsberichten abschalten
# Standard-Mailserver für alle ohne eigenen SMTP-Zugang: der Zugang des ersten Admins aus ADMIN_USER_IDS
# MAIL_DEFAULT_USER_ID=          anderes Konto als Quelle verwenden (UUID)
# MAIL_DEFAULT_ENABLED=false     Standard-Mailserver abschalten
# FEEDBACK_EMAIL=                Empfänger für Feedback (Standard: Empfänger des Standard-Mailservers)
